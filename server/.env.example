PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/guhasphere
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters-long
CLIENT_ORIGIN=http://localhost:5173

